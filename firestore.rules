rules_version = '2';

// =====================================================================
// STATS — Firestore security rules
// ---------------------------------------------------------------------
// This file is the COMPLETE ruleset. Paste it over whatever is in the
// console; it is not a patch and it does not assume anything about what
// is currently deployed.
//
// PHASE 1 (Game Night #1): players write their own score.
// PHASE 2 (Game Night #2 onward): the admin dashboard becomes the
//   scoring authority and players can no longer write `pts` at all.
//   The switch is the one commented line marked SWITCH below.
//
// Three things changed in this revision:
//   1. /nights/{nightId}/talk is written down properly. It has existed
//      in the deployed rules since the room shipped, but it was never in
//      this file, which meant the file was not the source of truth.
//   2. /signups accepts `sport` (the one-tap favourite on the handle
//      screen) and `verified` (set only when Firebase Auth says the
//      address on the row has been proven).
//   3. Every optional field on /signups now has a bound. Previously an
//      unlisted field passed unchecked, which is how one bored tester
//      with the console open could have written a megabyte into a row.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return 'aisoundz9@gmail.com';
    }

    function isOwner() {
      return request.auth != null
          && request.auth.token.email == ownerEmail()
          && request.auth.token.email_verified == true;
    }

    function signedIn() {
      return request.auth != null;
    }
    /* One shape for an error report, named once and used by both error
       paths, so the in-night log and the front-door log cannot drift into
       accepting different things. Sizes match what SB.logError already
       truncates to on the way out. */
    function validError() {
      return request.resource.data.uid == request.auth.uid
          && request.resource.data.where is string
          && request.resource.data.where.size() <= 40
          && request.resource.data.msg is string
          && request.resource.data.msg.size() <= 300
          && (!('extra' in request.resource.data) || (
                request.resource.data.extra is string
                && request.resource.data.extra.size() <= 200
             ))
          && (!('name' in request.resource.data) || (
                request.resource.data.name is string
                && request.resource.data.name.size() <= 24
             ))
          && (!('build' in request.resource.data) || (
                request.resource.data.build is string
                && request.resource.data.build.size() <= 40
             ))
          && (!('ua' in request.resource.data) || (
                request.resource.data.ua is string
                && request.resource.data.ua.size() <= 160
             ))
          && (!('screen' in request.resource.data) || (
                request.resource.data.screen is string
                && request.resource.data.screen.size() <= 40
             ));
    }
    // ---- Call It: live in-game side-game (isolated; never touches pts) ----
    match /nights/{nightId}/callit/{qid} {
      allow read:  if true;
      allow write: if isOwner();
      match /picks/{uid} {
        allow read:   if true;
        allow create: if signedIn() && request.auth.uid == uid
                      && get(/databases/$(database)/documents/nights/$(nightId)/callit/$(qid)).data.state == 'open';
        allow update, delete: if false;
      }
    }
    // ---- telemetry: how long a person actually watched ----------------
    // MINUTES WITH THE APP OPEN is the metric this product is built on —
    // it is what "the game pays you to pay attention" means in numbers.
    // index.html has been writing one doc per player per night since before
    // Game Night #11 and EVERY WRITE WAS DENIED, because this block did not
    // exist. SB.trkWrite catches the failure and returns false, so eleven
    // game nights produced exactly zero measurements in total silence —
    // the same shape as the `slate` collection having no rule, which made
    // the game picker invisible on the live site while every test passed.
    //
    // A person may only write their OWN row, and only the fields below;
    // nobody may read the collection from a phone, because one player's
    // attention is not another player's business. The reader is
    // host/minutes.js, which uses the Admin SDK and ignores rules.
    match /nights/{nightId}/telemetry/{uid} {
      allow read:           if isOwner();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.mins is number
                            && request.resource.data.mins >= 0
                            && request.resource.data.mins <= 1440;
      allow delete:         if isOwner();
    }

    /* ============ THE FEED THE STATS TAB READS =======================
       Added 20 Aug 2026, live, after the Stats tab said "Can't reach the
       league feed" for a player whose browser cannot reach ESPN at all.
       The runner fetches the summary server-side, where nothing blocks it,
       and publishes it here; the app reads it when its own fetch fails.

       World-readable on purpose. It is public sports data, it is what the
       scoreboard on the same screen already shows, and a rule that made it
       private would recreate the exact failure it exists to end. Only the
       owner writes it, which in practice means the runner's service
       account. */
    match /nights/{nightId}/feed/{docId} {
      allow read:  if true;
      allow write: if isOwner();
    }

    /* ============ THE TAPE — one question a day ======================
       Published each morning by host/tape.js from the backtest archive:
       one question about a game that already finished, its real options
       out of the bank, and the true answer.

       READ BY EVERYONE, because it is the only surface here that does not
       need a live game and the whole point is that a person can open it
       on a Tuesday with nothing on.

       THE ANSWER IS IN THE DOCUMENT, and that is deliberate. The question
       is about a FINISHED game — anyone can look it up in ten seconds, so
       hiding the answer would buy nothing and cost a round trip. It pays
       no Points and never touches the Board for exactly that reason: a
       lookup must never sit on the same table as somebody watching live.
       The reward is a streak, counted on the device.

       Written by the picker's service account only. */
    match /tape/{day} {
      allow read:  if true;
      allow write: if isOwner();
    }

    /* ============ HUSTLE — THE PRESENCE LEDGER =======================
       The second currency. Points are earned by being RIGHT; HUSTLE is
       earned by SHOWING UP, and that split is the whole reason this is a
       loyalty programme rather than a sweepstakes.

       READ BY EVERYONE, WRITTEN BY NOBODY WITH A PHONE. Note the contrast
       with callitboard directly below, where a signed-in player writes
       their own row: that is a REPORT of what they did, and firestore.rules
       bounds it as "still client-reported, honestly". A currency cannot be
       client-reported. A balance a phone can write is a balance a phone can
       forge, and "a count a phone can write is not a ledger" is the whole
       reason this path looks like the feed rather than like the board.

       So the runner computes it from evidence it already holds — chiefly
       nights/{n}/rounds/{r}/times/{uid}, which records who answered inside
       each window — and publishes it with the service account, exactly as
       it publishes caughtSrv precisely so the phone cannot write that down.

       isOwner() here means the founder's verified email; the Admin SDK the
       runner uses bypasses rules altogether. Either way: not a player. */
    match /nights/{nightId}/hustle/{uid} {
      allow read:  if true;
      allow write: if isOwner();
    }

    match /nights/{nightId}/callitboard/{uid} {
      allow read:           if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete:         if isOwner();
    }


    // ---- the game night itself: everyone reads, only you write ----
    match /nights/{nightId} {
      allow read:  if true;
      allow write: if isOwner();

      // ---- the plan the off-laptop runner reads ----
      // Owner only, read AND write, for exactly the same reason /key below
      // is: this document carries the question list AND any answer already
      // set by hand, so a public read would hand a player the key before
      // the round opens.
      //
      // The runner is unaffected by this line. It connects with a service
      // account through the Admin SDK, which does not consult these rules
      // at all. This exists so the Control Room can publish the plan, and
      // so nobody else can read it.
      match /plan/{doc} {
        allow read, write: if isOwner();
      }

      /* B26 — THE ARCHIVE. Eight game nights were played and the room's
         answers survive for none of them: one button cleared rounds and
         submissions, and it sits on the tab the host uses live. What the
         room THOUGHT would happen is the one thing this product knows that
         nobody else can, and it was being deleted within days.
      
         Owner-only read as well as write. An archive holds every player's
         raw picks for every round — it is the most revealing document in
         the database and the least reason for anyone else to read it. */
      match /archive/{stamp} {
        allow read, write: if isOwner();
      }

      // ---- rounds: questions and the answer key ----
      // Readable so phones can pick up a pushed round. The answer key is
      // NOT in this document while the round is live — it lives in the
      // owner-only /key subcollection below and is copied in at reveal.
      // That is what makes the key unreadable to a player who opens the
      // network tab, rather than merely inconvenient to find.
      match /rounds/{roundId} {
        allow read:  if true;
        allow write: if isOwner();

        // ---- the answer key, before it is revealed ----
        // Owner only, read AND write. Nothing else in the app ever touches
        // this path. Pre-load answers here days early and they stay secret.
        match /key/{keyDoc} {
          allow read, write: if isOwner();
        }

        // ---- submissions ----
        // One document per player per round, written once, at the moment
        // they finish the round and BEFORE the key exists anywhere public.
        // Create-only for the player: they cannot rewrite a pick after the
        // answer is revealed, which is the property that makes a submitted
        // round auditable rather than merely claimed.
        // B-71, 21 Aug. The founder, after the WNBA room had finished:
        // "after the quarter ended and the score was made i was able to
        // sign into the tempo and mystics game and put in entries after
        // the game."
        //
        // He could, and the comment four lines above claimed he could not:
        // "written once, at the moment they finish the round and BEFORE
        // the key exists anywhere public". Nothing enforced the timing.
        // Create-only stops a player REWRITING a pick after the reveal and
        // does nothing at all about writing a first one — so the whole
        // auditability claim rested on players not trying.
        //
        // The fix already existed in this file, forty lines up, on the
        // SIDE-GAME: Caught It picks require the parent card to be 'open'.
        // The main game — the one with the points — never got it. So the
        // same shape, against the round's own state. Once the runner flips
        // a round to 'scored' the key is public and the door is shut.
        // 24 Aug — found while reviewing this fix before deploy, not after.
        // index.html's lockPicks() files a SECOND kind of submission, at
        // roundId + '-local', whenever the built-in practice deck gets
        // answered instead of a round the host actually pushed. It exists
        // SPECIFICALLY so those answers can never impersonate a hosted
        // round and be graded against a key they never saw (that is the
        // "Denver Broncos" bug this file's own history is full of) — by
        // construction, a '-local' id never has a matching document in
        // /rounds. exists() on a document that can never exist is always
        // false, so gating '-local' writes on roundIsOpen would have
        // rejected every one of them, not just the ones for a closed
        // round — a second, different hole opened by closing the first.
        //
        // A '-local' id needs no liveness check: it is never read back
        // against a key, never scored, never shown to another player.
        // Everything that makes B-71's fix a real security property —
        // create-only, uid-locked, size-bounded — still applies below,
        // unchanged, to both kinds of submission.
        //
        // ============ 25 Aug — THE THIRD LANE, AND IT WENT LIVE ========
        // The review above found the SECOND kind of submission ('-local')
        // and carved it out. There is a THIRD, it was missed, the rule
        // shipped ANYWAY on 24 Aug 07:39 as ruleset c707bf5f, and it took
        // the prediction card off the air in production for two nights.
        //
        // index.html's lockPredPicks() files the pre-game card at round id
        // 'rP' — SB.submit('rP', ...) writing nights/{n}/rounds/rP/subs/
        // {uid}. Firestore permits a write under a parent document that
        // does not exist, and nothing in this codebase has EVER created a
        // nights/{n}/rounds/rP document: the Control Room's writePush()
        // and the runner both write 'r' + index, so the ids are r0..r3 and
        // nothing else. Verified against the live database, 25 Aug: thirty
        // nights, thirty with no rP document.
        //
        // So 'rP' did not match '-local', exists() on its round was false,
        // roundIsOpen() returned false, and every prediction card on every
        // night was refused — 600 of the night's 1,000 points, the single
        // biggest lane in the game. It is not a hypothetical: on 24 Aug,
        // slate-2026-08-24-atl-la took 7 round submissions from 3 seated
        // players across r0-r3 and ZERO cards, where every night before the
        // deploy has one card per player. The room was full. The card was
        // the only thing that could not be saved.
        //
        // And it took the anti-cheat with it. index.html's rejoin path uses
        // the EXISTENCE of subs/rP as the card's lock — "a server fact no
        // sign-out can clear". Deny the create and the lock can never be
        // set, so a player could sign out, sign back in and be handed a
        // blank card after the final buzzer. Closing B-71 for the rounds
        // re-opened B-71, wider, for the lane that is worth the most.
        //
        // THE FIX HERE IS THE NARROW ONE, DELIBERATELY. 'rP' joins '-local'
        // as a lane this function does not gate. That restores the card to
        // exactly the behaviour it had for the three weeks before 24 Aug,
        // and it leaves the timing gate closed on every REAL round — Q1-Q4,
        // innings, periods, extras — which is where B-71 was reported and
        // where the gate provably works, because those documents exist.
        //
        // It is written as its own named lane and not folded into the
        // '-local' regex on purpose. These are two different reasons: a
        // '-local' id is exempt because it is never scored against a key at
        // all, and 'rP' is exempt because THIS FILE HAS NO FACT TO GATE IT
        // ON YET. One of those is permanent and one is a debt. A future
        // reader must be able to tell them apart, and a regex spanning both
        // would hide the debt inside a settled decision.
        //
        // WHAT IS STILL OPEN, SAID PLAINLY. A first card can still be filed
        // after the game. Backtested against every prediction card ever
        // filed — 72 of them across 30 nights, 25 Aug — 16 were filed after
        // round one had already been pushed, one of them 49 hours late.
        // That is B-71 for the card lane and it is 22% of all cards, so it
        // is not theoretical. It is NOT closed here.
        //
        // THE FIX THAT WOULD CLOSE IT, for whoever picks this up. Gate 'rP'
        // on the ABSENCE of round one:
        //
        //     !exists(/databases/$(database)/documents/nights/$(n)/rounds/r0)
        //
        // nights/{n}/rounds/r0 is created the moment round one is pushed,
        // by the runner (host/run.js:1141) or by hand from the Control Room
        // (writePush(), admin.html:4007), both with state 'live'. Nothing
        // pre-creates it — the Control Room INFERS 'draft' from the document
        // being absent and never writes that state — so "r0 does not exist"
        // is exactly "this room has not started". Testing an ABSENCE is the
        // point: every way it can go wrong (nobody publishes, the runner
        // never boots, a room opens no rounds) leaves the card ACCEPTED,
        // which is survivable, where the failure we just lived through
        // refused everything and said nothing. It needs no backfill and
        // works on nights published before it existed. It is written and
        // tested — qa/rules.js carries the cases — and it is NOT deployed,
        // because it would newly refuse that 22%, and refusing a real
        // player needs the client to stop OFFERING the card once round one
        // is up (index.html startPredict()) rather than taking it, holding
        // it, and admitting four minutes later that it never landed.
        // Rules first is the wrong order for that one. Client first, then
        // this line.
        //
        // ============ AND THE GATE BELOW IS EATING REAL ANSWERS =========
        // Measured 25 Aug against every real-round submission ever made —
        // 119 of them with a recorded close time. The gap between a
        // submission landing and its round closing:
        //
        //     p10 -61s    p25 +14.9s    median +80.5s
        //     landed AFTER closedAt: 18 of 119
        //     within 5s of the close: 2      within 15s: 12
        //
        // A QUARTER of all answers land within fifteen seconds of the
        // close. Of the 18 that landed late, roughly ten were 0.3s-120s
        // late — a phone on a cold radio, a queued retry, somebody hitting
        // the buzzer — and the state=='live' gate below refuses every one
        // of them. The other eight (372s to 47,500s) are the B-71 pattern
        // the gate exists to stop, so it is doing real work; it is just
        // also taking honest answers with it, at something like 8%.
        //
        // This is NOT introduced by the 'rP' line above — it has been live
        // since 24 Aug and this change cannot make it better or worse. It
        // is recorded here because the measurement was expensive and the
        // next person to read this function needs it.
        //
        // 'state != scored' DOES NOT FIX IT, and it is the obvious thing to
        // reach for. Every round document ever written carries exactly one
        // of two states — 'live' (x2 right now) and 'scored' (x93) — plus
        // absent, which the Control Room reads as 'draft'. The race IS the
        // transition to 'scored', so both spellings deny identically. Nor
        // can a grace window be bolted on after it: 89 round documents
        // carry a public answer key and NOT ONE of them is still 'live'.
        // The key goes world-readable at the exact moment you would be
        // extending the window, so any grace after 'scored' is a window
        // with the answers on screen.
        //
        // THE FIX IS A THIRD STATE, and it belongs to the runner, not here.
        // Close in two phases: write state 'closed' with NO key, wait ~30s,
        // then write 'scored' WITH the key. The gate becomes
        //
        //     state == 'live' || state == 'closed'
        //
        // which accepts the late honest answer while the key is still
        // secret, and shuts the moment it is not. host/run.js:1141-1180 is
        // where the two writes would split. Not built.
        function roundIsOpen(n, r) {
          return r.matches('.*-local$')
            || r == 'rP'
            || (exists(/databases/$(database)/documents/nights/$(n)/rounds/$(r))
                && get(/databases/$(database)/documents/nights/$(n)/rounds/$(r)).data.state == 'live');
        }
        match /subs/{uid} {
          allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
          allow create: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.picks is list
            && request.resource.data.picks.size() <= 12
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 24
            && roundIsOpen(nightId, roundId);
          allow update, delete: if isOwner();
        }
      }

      // ---- players ----
      match /players/{uid} {

        // Public read: the leaderboard, the live count and your rank all
        // depend on it. Nothing sensitive is stored here — a display
        // name, a colour and a score. NEVER add an email or a phone
        // number to this document; this line is why.
        allow read: if true;

        // The owner can also write a row — that is what lets the dashboard
        // correct a score by hand, or overwrite one it does not believe.
        allow create, update: if isOwner();

        /* B15 — THE PLAYER NO LONGER WRITES THEIR OWN SCORE.
           pts, speed and roundsDone are graded from the submissions by the
           Control Room on reveal and by the off-laptop runner after it posts a
           key. Both go through the same shared tally, so the number cannot
           depend on which machine was awake. A signed-in player could
           previously set their own total from a browser console.
        
           Reads .get(field, 0) rather than the field directly: a document
           written by an older build might not carry all three, and a missing
           field in a rule is an error, which would lock that player out of
           their own row for the night.
        
           STILL CLIENT-REPORTED, HONESTLY: predPts and catchPts and caughtPts.
           Predictions settle on the phone and Caught It resolves there, so the
           server cannot derive them. They are BOUNDED here rather than trusted.
           The real ceilings: predictions max at 600 (six picks, 100 + 5x50 of
           base, plus 5x50 in exact-number bonuses) and Caught It is capped in
           the app at 100 a night. The bounds below leave headroom without
           leaving the door open. */
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.get('pts', 0) == 0
          && request.resource.data.get('speed', 0) == 0
          && request.resource.data.get('roundsDone', 0) == 0
          && request.resource.data.get('predPts', 0) is int
          && request.resource.data.get('predPts', 0) >= 0
          && request.resource.data.get('predPts', 0) <= 800
          && request.resource.data.get('catchPts', 0) is int
          && request.resource.data.get('catchPts', 0) >= 0
          && request.resource.data.get('catchPts', 0) <= 200
          && request.resource.data.get('caughtPts', 0) is int
          && request.resource.data.get('caughtPts', 0) >= 0
          && request.resource.data.get('caughtPts', 0) <= 200;

        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.get('pts', 0)        == resource.data.get('pts', 0)
          && request.resource.data.get('speed', 0)      == resource.data.get('speed', 0)
          && request.resource.data.get('roundsDone', 0) == resource.data.get('roundsDone', 0)
          && request.resource.data.get('predPts', 0) is int
          && request.resource.data.get('predPts', 0) >= 0
          && request.resource.data.get('predPts', 0) <= 800
          && request.resource.data.get('catchPts', 0) is int
          && request.resource.data.get('catchPts', 0) >= 0
          && request.resource.data.get('catchPts', 0) <= 200
          && request.resource.data.get('caughtPts', 0) is int
          && request.resource.data.get('caughtPts', 0) >= 0
          && request.resource.data.get('caughtPts', 0) <= 200;

        // SWITCH — Phase 2. Uncomment to make the admin dashboard the only
        // thing that can set a score, and delete the two `pts` lines above.
        //   && request.resource.data.pts == resource.data.pts

        // Only you can clear a player out (spam, a duplicate, a test row).
        allow delete: if isOwner();

        // ---- a player's submitted answers ----
        // Written by the player, scored by the dashboard. Once written for
        // a round they cannot be rewritten, so nobody can change an answer
        // after seeing the key.
        match /answers/{roundId} {
          allow read:   if signedIn() && request.auth.uid == uid || isOwner();
          allow create: if signedIn() && request.auth.uid == uid;
          allow update, delete: if isOwner();
        }
      }

      // ---- the room ----
      // Free-text chat during a game night. This started life as a set of
      // pre-written lines with a Copy button and no text box at all, on
      // the reasoning that nothing typed means nothing to moderate. The
      // reasoning was sound and the feature still failed: nobody copies
      // and pastes. It is a real chat box now, and these rules are the
      // part of that decision that has to be paid for rather than argued.
      //
      // PUBLIC READ. Everyone playing tonight sees every line, which
      // means anything written here is effectively published. The client
      // strips links and long digit runs before sending; that is a
      // courtesy, not a control, because a client is not a control.
      //
      // Create-only, and only under your own uid. A line cannot be edited
      // after it lands and cannot be attributed to somebody else. Nobody
      // but the owner can delete — that is the "clear the room" control,
      // and it belongs to exactly one person.
      //
      // `at` is deliberately not validated as a server timestamp. The
      // ordering it produces is a convenience, not a security property,
      // and a rule that rejects a clock skew costs a real message.
      match /talk/{msgId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 140
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && (!('color' in request.resource.data) || (
                request.resource.data.color is string
                && request.resource.data.color.size() <= 12
             ))
          && (!('kind' in request.resource.data) || (
                request.resource.data.kind is string
                && request.resource.data.kind.size() <= 12
             ));

        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // ---- the list ----
    // Contact details, volunteered on the handle screen or at the end of a
    // game night. This is the one collection in the database that holds
    // personal information, so it is the one collection nobody but the
    // owner can read — not "hard to find", not "obscured", refused at the
    // database.
    //
    // A player may write their own row and rewrite it (they fix a typo, they
    // add a number later). They may not read anyone's, including their own,
    // because there is no screen that needs to and every capability granted
    // here is a capability that has to hold up on a phone we don't control.
    //
    // `consent == true` is enforced HERE, not just in the form. A checkbox
    // is a UI convention; this is the thing that makes an unchecked box
    // impossible to work around, and it is what makes the row evidence
    // rather than an assertion. Under TCPA the burden of proving consent is
    // ours — so the database refuses to store a contact without it.
    /* TONIGHT'S GAME — readable by anybody, writable by nobody but the host.
       This is the matchup, the rosters and the pick sheet: exactly what the
       landing page already shows a signed-out stranger, so there is nothing
       here to protect from a reader. It is public on purpose, because a
       player who is not signed in still has to see which game is on.

       Writes are another matter — this document decides which game the whole
       room plays. host/publish-night.js writes it with the Admin SDK and
       bypasses rules entirely; this clause is what stops anyone else.

       `current` is the pointer that names tonight's night, and it lives in
       the same collection under the same rule, which is why the pattern
       matches any {id} rather than a night-shaped one. */
    match /schedule/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    /* THE SLATE — every game of the night, and the pointer that names the
       date. Exactly the same shape and the same reasoning as schedule/
       above: it decides what the room is offered, it is written only by
       build-slate.js through the Admin SDK, and it has to be READABLE by
       anybody or the picker cannot render.

       WHY THIS RULE EXISTS AT ALL, WRITTEN DOWN SO NOBODY REPEATS IT:
       the slate shipped without one. The catch-all below closed it, so
       every read failed, the picker never rendered and a ?game= link
       landed everyone in the flagship. The code was correct and the
       feature was invisible — and it was invisible in a way NO test in
       this repo could see, because the browser suites stub Firestore and
       the node tools use the Admin SDK, which bypasses rules entirely.
       Both layers were green while the live site had no picker at all.
       It was caught by opening the real link on the real domain.

       A new top-level collection needs a rule in the SAME change that
       creates it. There is no test that will tell you. */
    match /slate/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    /* ============ PUSH SUBSCRIPTIONS ==================================
       One document per BROWSER, not per person: the same player on a
       phone and a laptop is two subscriptions and both are real. The id
       is derived from the endpoint by the client, so a browser always
       lands on its own row rather than overwriting somebody else's.

       A subscription is not a secret — the endpoint is a public URL the
       push service issues — but it IS a way to reach somebody, so:
         - only a signed-in player may write one
         - the uid on the row must be their own, which is what stops one
           player from pointing a subscription at another's device
         - nobody may read this collection from a browser at all. Only
           the runner, on the server, ever needs to enumerate it.

       Deleting is allowed for the owner so a player who turns alerts off
       can take themselves off it. The server prunes dead ones too, and
       admin bypasses rules entirely. */
    match /push/{subId} {
      allow read: if false;

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 20
        && request.resource.data.endpoint.size() <= 800
        && request.resource.data.endpoint.matches('^https://.*')
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string
        && request.resource.data.auth.size() <= 60
        && (!('name' in request.resource.data) || (
              request.resource.data.name is string
              && request.resource.data.name.size() <= 24
           ));

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /signups/{uid} {
      allow read: if isOwner();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.consent == true
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && (!('phone' in request.resource.data) || (
              request.resource.data.phone is string
              && request.resource.data.phone.size() >= 10
              && request.resource.data.phone.size() <= 20
           ))
        // Favourite sport: the one-tap question on the handle screen.
        && (!('sport' in request.resource.data) || (
              request.resource.data.sport is string
              && request.resource.data.sport.size() <= 40
           ))
        // Free-text and multi-select from the longer "what do you watch"
        // sheet. Bounded here as well as in the client, because the client
        // is a suggestion and this is not. The lists are bounded by LENGTH
        // only — the rules language has no way to walk a list and check
        // every element, so the per-element cap stays a client concern and
        // the size cap here is what stops a row getting large.
        && (!('teams' in request.resource.data) || (
              request.resource.data.teams is string
              && request.resource.data.teams.size() <= 120
           ))
        && (!('freq' in request.resource.data) || (
              request.resource.data.freq is string
              && request.resource.data.freq.size() <= 40
           ))
        && (!('src' in request.resource.data) || (
              request.resource.data.src is string
              && request.resource.data.src.size() <= 24
           ))
        && (!('night' in request.resource.data) || (
              request.resource.data.night is string
              && request.resource.data.night.size() <= 60
           ))
        && (!('sports' in request.resource.data) || (
              request.resource.data.sports is list
              && request.resource.data.sports.size() <= 40
           ))
        && (!('watch' in request.resource.data) || (
              request.resource.data.watch is list
              && request.resource.data.watch.size() <= 8
           ))
        && (!('prize' in request.resource.data) || (
              request.resource.data.prize is list
              && request.resource.data.prize.size() <= 8
           ))
        // `verified` may only be true when the token on this request
        // actually carries a verified address. Otherwise a player could
        // mark their own row proven from the console, which would make the
        // whole flag worth nothing — and this flag is the one thing that
        // separates a deliverable list from a list of typos.
        && (!('verified' in request.resource.data) || (
              request.resource.data.verified == false || (
                request.resource.data.verified == true
                && request.auth.token.email_verified == true
              )
           ));

      // Removing someone from the list has to actually work — an unsubscribe
      // that doesn't delete is worse than no unsubscribe at all. Two people
      // are allowed to do it: the owner, and the person whose row it is.
      //
      // The second half of that is not a nicety. Three screens in the app
      // promise "unsubscribe any time"; until this line existed, that promise
      // had no mechanism behind it on the only list we actually hold. A
      // consent copy that describes a button nobody built is the kind of
      // thing that is fine right up until the first person asks.
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    /* ============ THE ERROR LOG HAS NEVER WORKED ======================
       30 Aug 2026. SB.logError() has been writing to
       nights/{nightId}/errors since it was added, and NO RULE HAS EVER
       NAMED THAT PATH — so the catch-all below denied every one of them,
       and the `.catch(function(){})` on the write swallowed the denial.

       Measured before writing this rule: 312 nights, ZERO error
       documents, ever. Every "0 error document(s)" line in every debrief
       was the rules refusing the write, not a quiet night. The debrief
       already warned that zero was a finding rather than a clean bill of
       health; it was the stronger reading the whole time.

       WRITE-ONLY FOR PLAYERS. A phone may add a report and may never read
       one back, list them, edit one or delete one — an error row carries
       another person's user agent and uid, and nothing about it belongs
       to the person who happened to trigger it. The owner reads them.

       Bounded here as well as in the client, because the client is a
       suggestion and this is not. */
    match /nights/{nightId}/errors/{errId} {
      allow read:   if isOwner();
      allow create: if signedIn() && validError();
      allow update, delete: if isOwner();
    }

    /* ============ AND THE FRONT DOOR HAD NOWHERE AT ALL ===============
       Every failure that happens BEFORE somebody joins a night — the home
       page, the landing page, the signup form, sign-in, the email field —
       could not be reported even in principle, because the only error
       path in the app was scoped to a night id and bailed without one.

       That is the exact blind spot that let a broken signup survive four
       days and two people: nothing was wrong with the monitoring, there
       was no monitoring where strangers actually are.

       Same shape as above, at the top level, keyed by auto-id. */
    match /errors/{errId} {
      allow read:   if isOwner();
      allow create: if signedIn() && validError();
      allow update, delete: if isOwner();
    }

    // Everything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
